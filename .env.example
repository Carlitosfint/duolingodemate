# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Postgres connection used by the app at runtime (src/db/index.ts).
# For Supabase: Project Settings -> Database -> Connection string.
SQL_HOST="MY_SUPABASE_HOST"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="MY_SUPABASE_DB_PASSWORD"
SQL_DB_NAME="postgres"
# Supabase (and most managed Postgres) require SSL; only set this to
# "false" for a local Postgres that doesn't support it.
SQL_SSL="true"

# Used only by drizzle-kit to run migrations (src/db/drizzle.config.ts),
# kept separate from the runtime user above so the app itself can run
# with a less-privileged DB role if you set one up later.
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="MY_SUPABASE_DB_PASSWORD"

# Desarrollo local: si SQL_HOST no existe, el servidor usa automáticamente
# PostgreSQL embebido y guarda sus datos en .local-data/. El primer usuario
# autenticado se crea como student. Opcionalmente puedes usar uno de estos
# roles para probar sus pantallas: student, teacher, secretary o admin.
LOCAL_DEV_ROLE="student"

# Needed by firebase-admin (src/lib/firebase-admin.ts) to verify login
# tokens and create accounts when running outside of Google Cloud.
# Firebase Console -> Project settings -> Service accounts -> Generate
# new private key, then point this at the downloaded JSON file.
GOOGLE_APPLICATION_CREDENTIALS="MY_FIREBASE_SERVICE_ACCOUNT_JSON_PATH"

# Quién opera la plataforma (no un colegio): lista de correos separados
# por coma con acceso a /api/platform y a la consola de colegios.
# Vive aquí y no en la base de datos a propósito — así no existe ninguna
# ruta dentro de la app para concederse este permiso: hace falta acceso
# al servidor. Déjalo vacío y nadie tiene consola de plataforma.
PLATFORM_ADMIN_EMAILS=""
