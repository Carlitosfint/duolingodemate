                      <div className="bg-teal-50 p-3 rounded-lg text-center text-teal-800 border border-teal-100 font-medium">
                        Hipotenusa = <b>2k</b> | Opuesto a 30° = <b>k</b> | Opuesto a 60° = <b>k√3</b>
                      </div>
